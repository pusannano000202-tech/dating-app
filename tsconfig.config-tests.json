{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": ".tmp/config-tests",
    "types": ["node"],
    "noEmit": false
  },
  "include": [
    "lib/utils.ts",
    "lib/university-theme.ts",
    "lib/university-departments.ts",
    "lib/payments/**/*.ts",
    "lib/refund/**/*.ts",
    "docs/design-mockups/**/*.json",
    "docs/research/university-departments/**/*.json",
    "tests/config/**/*.ts"
  ]
}

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": ".tmp/profile-tests",
    "types": ["node"],
    "noEmit": false
  },
  "include": [
    "components/profile/DepartmentPicker.tsx",
    "lib/school-theme.ts",
    "lib/pnu-departments.ts",
    "lib/gender.ts",
    "lib/profile/**/*.ts",
    "tests/profile/**/*.ts"
  ]
}

# Supabase (Dashboard > Project Settings > API Keys / Connect)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3004
# Local-only dev preview auth. Keep false for production and Vercel.
NEXT_PUBLIC_DEV_AUTH_BYPASS=false
# Community and meetups stay preview-only until their backend and RLS contract is approved.
NEXT_PUBLIC_COMMUNITY_ENABLED=false
# Campus Eats stays disabled in production until candidate data and map access are approved.
NEXT_PUBLIC_CAMPUS_EATS_ENABLED=false
# Browser-safe Naver Maps JavaScript API ncpKeyId. Leave blank to show the fallback state.
NEXT_PUBLIC_NAVER_MAPS_NCP_KEY_ID=
# Seven-day campus program. Keep all three false until identity, legal, and payment review pass.
NEXT_PUBLIC_CAMPUS_SEVEN_ENABLED=false
CAMPUS_SEVEN_APPLICATIONS_OPEN=false
CAMPUS_SEVEN_CARD_PAYMENTS_ENABLED=false
# Timed in-app and browser notifications. Keep false until DB/Cron/Vault review.
CAMPUS_SEVEN_NOTIFICATIONS_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:ops@example.com
CAMPUS_SEVEN_PUSH_CRON_SECRET=

# New projects: prefer the publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Legacy projects: the anon key also works. Leave this empty if using publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Appearance AI server. No NEXT_PUBLIC prefix because this is server-side only.
AI_SERVER_URL=http://localhost:8001
AI_SERVER_TIMEOUT_MS=30000
AI_SERVER_SECRET=replace-with-a-long-random-shared-secret

# Payment provider.
# Use mock for local UI review. Use toss only with Toss sandbox keys.
NEXT_PUBLIC_PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER=mock

# Kakao Talk Share. Browser-safe JavaScript key from Kakao Developers > App > App keys.
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=
# Optional: force Kakao message links to a public HTTPS app origin during local testing.
NEXT_PUBLIC_KAKAO_SHARE_ORIGIN=

# Toss Payments sandbox.
# NEXT_PUBLIC_TOSS_CLIENT_KEY is safe for the browser. TOSS_SECRET_KEY is server-only.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# Server-only keys. Never expose these with NEXT_PUBLIC_.
# PAYMENT_INTERNAL_SECRET protects internal refund/cancel calls.
# SUPABASE_SECRET_KEY is preferred for server routes and must use an sb_secret_ key.
# SUPABASE_SERVICE_ROLE_KEY is a legacy service_role JWT fallback.
PAYMENT_INTERNAL_SECRET=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (Dashboard > Project Settings > API Keys / Connect)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3004
# Local-only dev preview auth. Keep false for production and Vercel.
NEXT_PUBLIC_DEV_AUTH_BYPASS=false
# Community and meetups stay preview-only until their backend and RLS contract is approved.
NEXT_PUBLIC_COMMUNITY_ENABLED=false
# Campus Eats stays disabled in production until candidate data and map access are approved.
NEXT_PUBLIC_CAMPUS_EATS_ENABLED=false
# Browser-safe Naver Maps JavaScript API ncpKeyId. Leave blank to show the fallback state.
NEXT_PUBLIC_NAVER_MAPS_NCP_KEY_ID=
# Tonight ranked matching. Keep all false until migrations, role accounts and payment E2E pass.
NEXT_PUBLIC_TONIGHT_ENABLED=false
TONIGHT_APPLICATIONS_OPEN=false
TONIGHT_CARD_PAYMENTS_ENABLED=false
# Intake only: deposit/refund/reconciliation/settlement workers continue when this is false.
# Predeploy requires false; switch to true only for the explicit launch-readiness check.
TONIGHT_AUTOMATION_ENABLED=false
TONIGHT_PARTNER_FEE_PER_ATTENDEE=1000
TONIGHT_NO_SHOW_FORFEIT_POLICY_APPROVED=false
TONIGHT_CRON_SCHEDULER=
TONIGHT_NOTIFICATIONS_ENABLED=false
# Provider concurrency stays bounded. These are examples, not applied configuration.
# Refund/reconciliation call Toss, so 공급자 동시성은 5 이하로 유지합니다.
# 실제 Toss 처리량과 rate limit은 Preview 부하 검증 전까지 확정하지 않습니다.
TONIGHT_REFUND_BATCH_SIZE=15
TONIGHT_REFUND_CONCURRENCY=3
TONIGHT_REFUND_BUDGET_MS=40000
TONIGHT_REFUND_MAX_BATCHES=50
TONIGHT_REFUND_BACKLOG_SLO=500
TONIGHT_RECONCILIATION_BATCH_SIZE=20
TONIGHT_RECONCILIATION_CONCURRENCY=3
TONIGHT_RECONCILIATION_BUDGET_MS=40000
TONIGHT_RECONCILIATION_MAX_BATCHES=50
TONIGHT_RECONCILIATION_BACKLOG_SLO=500
TONIGHT_DEPOSIT_FINALIZE_BATCH_SIZE=100
TONIGHT_DEPOSIT_FINALIZE_CONCURRENCY=10
TONIGHT_DEPOSIT_FINALIZE_BUDGET_MS=45000
TONIGHT_DEPOSIT_FINALIZE_MAX_BATCHES=100
TONIGHT_DEPOSIT_FINALIZE_BACKLOG_SLO=2000
TONIGHT_SETTLEMENT_BATCH_SIZE=100
TONIGHT_SETTLEMENT_CONCURRENCY=20
TONIGHT_SETTLEMENT_BUDGET_MS=45000
TONIGHT_SETTLEMENT_MAX_BATCHES=100
TONIGHT_SETTLEMENT_BACKLOG_SLO=2000
# Seven-day campus program. Keep all three false until identity, legal, and payment review pass.
NEXT_PUBLIC_CAMPUS_SEVEN_ENABLED=false
CAMPUS_SEVEN_APPLICATIONS_OPEN=false
CAMPUS_SEVEN_CARD_PAYMENTS_ENABLED=false
# Timed in-app and browser notifications. Keep false until DB/Cron/Vault review.
CAMPUS_SEVEN_NOTIFICATIONS_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:ops@example.com
CAMPUS_SEVEN_PUSH_CRON_SECRET=

# New projects: prefer the publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Legacy projects: the anon key also works. Leave this empty if using publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Appearance AI server. No NEXT_PUBLIC prefix because this is server-side only.
AI_SERVER_URL=http://localhost:8001
AI_SERVER_TIMEOUT_MS=30000
AI_SERVER_SECRET=replace-with-a-long-random-shared-secret

# Payment provider.
# Use mock for local UI review. Use toss only with Toss sandbox keys.
NEXT_PUBLIC_PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER=mock

# Kakao Talk Share. Browser-safe JavaScript key from Kakao Developers > App > App keys.
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=
# Optional: force Kakao message links to a public HTTPS app origin during local testing.
NEXT_PUBLIC_KAKAO_SHARE_ORIGIN=

# Toss Payments sandbox.
# NEXT_PUBLIC_TOSS_CLIENT_KEY is safe for the browser. TOSS_SECRET_KEY is server-only.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# Server-only keys. Never expose these with NEXT_PUBLIC_.
# PAYMENT_INTERNAL_SECRET protects internal refund/cancel calls.
# SUPABASE_SECRET_KEY is preferred for server routes and must use an sb_secret_ key.
# SUPABASE_SERVICE_ROLE_KEY is a legacy service_role JWT fallback.
PAYMENT_INTERNAL_SECRET=
CRON_SECRET=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Match the actual provider OTP TTL; no SMS is enabled by this example.
SUPABASE_PHONE_OTP_TTL_SECONDS=
PHONE_VERIFICATION_DIGEST_SECRET=
PROFILE_ALIAS_SIGNING_SECRET=
# Opt-in local fake-money simulator; production ignores this flag.
CONTINUATION_LOCAL_PAYMENT_SIMULATOR_ENABLED=false
## Community voice: use a separate test provider, never paste production credentials here.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_CONNECT_ORIGINS=
VOICE_WORKER_SECRET=
FRIEND_INVITE_TOKEN_SECRET=
ACCOUNT_DELETION_WORKER_ENABLED=false

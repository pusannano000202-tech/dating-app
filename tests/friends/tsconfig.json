{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "../..",
    "outDir": "../../.tmp/friends-tests",
    "types": ["node"],
    "noEmit": false
  },
  "include": [
    "../../lib/friends/**/*.ts",
    "../../tests/friends/**/*.ts"
  ]
}

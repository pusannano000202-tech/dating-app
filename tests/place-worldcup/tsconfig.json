{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "commonjs",
    "moduleResolution": "node",
    "baseUrl": "../..",
    "paths": { "@/*": ["./*"] },
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "../..",
    "outDir": "../../.tmp/place-worldcup-tests",
    "types": ["node"],
    "noEmit": false
  },
  "include": ["../../lib/place-worldcup/**/*.ts", "./*.test.ts"]
}

# OpenAI server-only key. Never expose it to the web or mobile client.
OPENAI_API_KEY=replace-with-an-openai-api-key
OPENAI_APPEARANCE_MODEL=gpt-5.6-terra

# Next.js server and AI server must share this server-only secret.
AI_SERVER_SECRET=replace-with-a-long-random-shared-secret

# Human-approved appearance reference configuration.
APPEARANCE_PROMPT_VERSION=appearance-anchor-v3
APPEARANCE_ANCHOR_BASE_URL=https://your-project.supabase.co/storage/v1/object/public/appearance-anchors

# 서버 포트
PORT=8001

# CORS 허용 오리진 (쉼표로 구분)
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Exact photo hostnames allowed by the analysis endpoint. Do not include schemes,
# paths, wildcards, or ports. An empty combined allowlist rejects every photo URL.
APPEARANCE_ALLOWED_PHOTO_HOSTS=your-project.supabase.co

# The root Next.js environment also provides this URL in deployed environments.
# Its hostname is added to the photo allowlist automatically.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
